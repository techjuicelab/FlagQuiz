# 1Password에 해당 항목을 등록한 뒤 사용한다. 아래 참조는 설정용 템플릿이다.
# Google OAuth redirect URI: PUBLIC_ORIGIN + /api/auth/callback
PUBLIC_ORIGIN="op://AI Automation/FlagQuiz Private/public_origin"
PORT=8090
STATE_DIR="op://AI Automation/FlagQuiz Private/state_directory"
GOOGLE_CLIENT_ID="op://AI Automation/FlagQuiz Private/google_client_id"
GOOGLE_CLIENT_SECRET="op://AI Automation/FlagQuiz Private/google_client_secret"
SESSION_SECRET="op://AI Automation/FlagQuiz Private/session_secret"
OPENAI_API_KEY="op://AI Automation/FlagQuiz Private/openai_api_key"
